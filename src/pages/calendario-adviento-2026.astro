        <!-- <h1 class="text-center text-4xl">Calendario de Adviento 2026</h1> -->
        <img src="https://res.cloudinary.com/dr5knskbb/image/upload/v1793796932/hero-provisional_vqbax0.webp" alt="" class="mb-4">
        <!-- <form class="mb-16 mt-8">
            <p class="text-center font-medium">Descubre la información del café del dia</p>
            <input type="number" name="dia" id="dia" placeholder="Ingresa el día" class="border-2 border-green-900 rounded-lg p-2 w-full mb-4" />
            <button type="submit" class="bg-green-900 text-white py-2 px-4 rounded-lg hover:bg-green-800 w-full text-2xl">Ver información</button>
        </form>
         -->
