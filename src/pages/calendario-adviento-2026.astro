        <div class="grid grid-cols-4 grid-rows-6 gap-4 mb-8">
            {
                calendario.map((item) => (
                    <a href={`calendario-adviento-2026/dia-${item.dia}`} class="flex items-center justify-center aspect-square overflow-hidden text-5xl border-2 border-green-900 rounded-full text-green-900 no-underline! font-bold">
                        {item.dia}
                        {/* <img src={item.img} alt={`Día ${item.dia}`} /> */}
                    </a>
                ))
            }
        </div>
    </div>

</Layout>


