---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";

type CafeEntry = CollectionEntry<"cafes">;

export async function getStaticPaths() {
    const cafes: CafeEntry[] = await getCollection("cafes");

    return cafes.map((cafe) => ({
        params: { slug: cafe.id },
        props: { cafe },
    }));
}

const { cafe } = Astro.props as { cafe: CafeEntry };
const { Content } = await render(cafe);
---

<Layout theme={cafe.data.theme} title={cafe.data.title}>
    <main class={`border-4 ${cafe.data.color ?? "border-black"}`}>
        <Content />
    </main>
</Layout>