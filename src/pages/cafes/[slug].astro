---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
    const cafes = await getCollection("cafes");

    console.log(
		cafes.map((cafe) => ({
			id: cafe.id,
			slug: cafe.data.slug
		}))
	);

    return cafes.map((cafe) => ({
        params: { slug: cafe.id },
        props: { cafe },
    }));
}

const { cafe } = Astro.props;
const { Content } = await render(cafe);

import Layout from "@layouts/Layout.astro";
import Hero from "@components/Hero.astro";
import StickyNavigation from "@components/StickyNavigation.astro";
---

<Layout theme={cafe.data.theme} title={cafe.data.title}>
    <!-- {
        cafe.data.image && <img src={cafe.data.image} alt={cafe.data.title} class="max-w-200 m-auto w-full"/>
    } -->
    <main class=`border-4 ${cafe.data.color}`>
        <Content />
    </main>
</Layout> 