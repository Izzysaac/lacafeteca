---

const { image, title, description } = Astro.props;
---


<header class="m-auto">
    <img  src={image.url} alt={image.alt} class="object-cover w-full"/>
    <div class="text-center px-4 text-pretty">
        <h1 class="text-3xl font-bold">{title}</h1>
        <p class="text-lg whitespace-pre-line mb-3">{description}</p>
    </div>
</header>