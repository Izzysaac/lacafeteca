---

const { images } = Astro.props;

---

<div class="grid grid-cols-3 gap-0.5 py-0.5">
    {
        images.map((image: any) => (
                <img src={image.src} alt={image.alt} class="galeria max-w-200 m-auto w-full object-cover aspect-3/4" loading="lazy"/>
            ))
    }
</div>  

<dialog id="imageViewer">
    <button id="imageViewerCloseBtn" aria-label="Cerrar" aria-label="Cerrar" class="text-white bg-black outline-0 z-10"
        >✕</button
    >
    <figure class="relative">
        <img id="imageViewerImg" data-action="viewImage" />
        <figcaption id="imageViewerCaption" class="absolute bottom-0 left-0 right-0 bg-black bg-opacity-50 text-white p-2"></figcaption>
    </figure>
</dialog>

<script>
    const dialog = document.getElementById("imageViewer");
    const dialogImage = document.getElementById("imageViewerImg");
    const dialogImageCaption = document.getElementById("imageViewerCaption");
    const closeButton = document.getElementById("imageViewerCloseBtn");

    document.querySelectorAll(".galeria").forEach((image) => {
        image.addEventListener("click", () => {
            dialogImage.src = image.src;
            dialogImage.alt = image.alt;
            dialogImageCaption.textContent = image.alt;
            dialog.showModal();
        });
    });

    dialog.addEventListener("click", (e) => {
        if(e.target === dialog || e.target === closeButton) dialog.close();
    });
</script>

<style>
    dialog::backdrop {
        background: rgba(0, 0, 0, 0.7);
    }

    dialog#imageViewer {
        border: none;
        padding: 0;
        background: transparent;
        max-width: 100vw;
        max-height: 75vh;
        margin: auto;
    }

    #imageViewerImg {
        object-fit: contain;
        width: 100%;
        max-width: 500px;
        height: auto;
        max-height: 75vh;
        border-radius: 12px;
        transition: filter 0.3s ease;
    }

    #imageViewerImg.blurred {
        filter: blur(2px);
    }

    #imageViewerCloseBtn {
        position: absolute;
        top: 12px;
        right: 12px;
        border: none;
        border-radius: 50%;
        width: 36px;
        height: 36px;
        font-size: 18px;
        cursor: pointer;
    }
</style>