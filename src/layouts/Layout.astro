---
import Analytics from '@vercel/analytics/astro'
const { theme, title } = Astro.props;

---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>

    <Analytics />
</head>
<body data-theme={theme}>
    <slot/>
</body>
</html>

<style is:global>
    @import "tailwindcss";

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		font-family: "Inter", sans-serif;
        font-weight: regular;
		scroll-behavior: smooth;
	}
    [data-theme="bakerscoffee"] {
        --background-color: rgb(34, 47, 29);
        --titles: rgb(189, 128, 97);
        --text: rgb(213, 178, 140);
    }

    [data-theme="green"] {
        --accent: #2e7d32;
    }

    [data-theme="orange"] {
        --accent: #d97706;
    }
    body {
        background-color: var(--background-color);
        color: var(--text);
    }
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        color: var(--titles);
        font-weight: bold;
        margin: 1rem 0;
    }

    image{
        width: 100%;
    }
</style>
