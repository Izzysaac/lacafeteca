---
import Analytics from '@vercel/analytics/astro'
const { theme, title } = Astro.props;

---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <link rel="preload" href="/lacafeteca.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preconnect" href="//res.cloudinary.com" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="icon" href="/lacafeteca-logo.webp" type="image/webp" />
    <meta name="description" content="Cafeteca" />
    <Analytics />
</head>
<body data-theme={theme}>
    <slot/>
</body>
</html>

<style is:global>
    @import "tailwindcss";

    @font-face {
        font-family: "lacafeteca";
        src: url("/lacafeteca.woff2") format("woff2");
		font-weight: 200 800;
		font-style: normal;
    }
	html,
	body {
		margin: auto;
		width: 100%;
        max-width: 1200px;
		height: 100%;
		font-family: "lacafeteca", sans-serif;
        font-weight: regular;
		scroll-behavior: smooth;
	}
/* #2C2C2C; */
    [data-theme="deiroscoffee"] {
        --background-color: #fcfcfc;
        --titles: #007a3f;
        --text: #0a0a0a;
    }

    [data-theme="bakerscoffee"] {
        --background-color: rgb(34, 47, 29);
        --titles: rgb(189, 128, 97);
        --text: rgb(213, 178, 140);
    }

    
    [data-theme="orange"] {
        --accent: #d97706;
    }
    body {
        background-color: var(--background-color);
        color: var(--text);
    }
    h1,
    h2,
    h3,
    h4,
    h5,
    h6 {
        color: var(--titles);
        font-weight: bold;
        margin: 1rem 0;
        padding: 0 12px;
        text-align: center;
    }
    p {
        margin: 1rem 0;
        padding: 0 12px;
    }   

    image{
        width: 100%;
    }

    audio {
        margin: 1rem auto;
    }

    .full-screen-img {
        display: block;
        width: calc(100vw + 24px); /* Suma los 12px de padding izquierdo y derecho */
        /* margin-left: -12px;   */
    }
</style>
